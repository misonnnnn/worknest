generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_CHANGED
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  email                  String                @unique
  passwordHash           String
  isActive               Boolean               @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  employee               Employee?
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  requestedRequisitions  PurchaseRequisition[] @relation("RequisitionRequester")
  approvedRequisitions   PurchaseRequisition[] @relation("RequisitionApprover")
  typingTestResults      TypingTestResult[]
  numberMemoryResults    NumberMemoryResult[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Department {
  id            String                @id @default(uuid()) @db.Uuid
  name          String                @unique
  code          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  employees     Employee[]
  positions     Position[]
  requisitions  PurchaseRequisition[]

  @@index([isActive])
  @@map("departments")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  code         String      @unique
  description  String?
  departmentId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  employeeNumber   String           @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String           @unique
  phone            String?
  dateOfBirth      DateTime?        @db.Date
  hireDate         DateTime         @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  userId           String?          @unique @db.Uuid
  departmentId     String?          @db.Uuid
  positionId       String?          @db.Uuid
  managerId        String?          @db.Uuid
  photoUrl         String?
  photoStorageKey  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position         Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]       @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model MediaFolder {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?       @db.Uuid
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("MediaFolderTree")
  files     MediaFile[]

  @@index([parentId])
  @@map("media_folders")
}

model MediaFile {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  folderId   String?      @db.Uuid
  storageKey String
  url        String
  mimeType   String
  size       Int
  alt        String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([storageKey])
  @@map("media_files")
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

model Product {
  id             String                     @id @default(uuid()) @db.Uuid
  sku            String                     @unique
  name           String
  description    String?
  unit           String                     @default("pcs")
  trackInventory Boolean                    @default(true)
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  poLines        PurchaseOrderLine[]
  prLines        PurchaseRequisitionLine[]

  @@index([isActive])
  @@map("products")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

model Warehouse {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("warehouses")
}

model StockBalance {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  type          StockMovementType
  warehouseId   String            @db.Uuid
  productId     String            @db.Uuid
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([warehouseId, productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model PurchaseRequisition {
  id            String                     @id @default(uuid()) @db.Uuid
  number        String                     @unique
  status        PurchaseRequisitionStatus  @default(DRAFT)
  requestedById String                     @db.Uuid
  departmentId  String?                    @db.Uuid
  notes         String?
  approvedById  String?                    @db.Uuid
  approvedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  requestedBy   User                       @relation("RequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?                      @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  department    Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lines         PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([requestedById])
  @@index([departmentId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id             String              @id @default(uuid()) @db.Uuid
  requisitionId  String              @db.Uuid
  productId      String              @db.Uuid
  quantity       Int
  notes          String?
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([requisitionId])
  @@index([productId])
  @@map("purchase_requisition_lines")
}

model PurchaseOrder {
  id             String               @id @default(uuid()) @db.Uuid
  number         String               @unique
  supplierId     String               @db.Uuid
  warehouseId    String               @db.Uuid
  requisitionId  String?              @db.Uuid
  status         PurchaseOrderStatus  @default(DRAFT)
  orderDate      DateTime             @db.Date
  notes          String?
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  supplier       Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requisition    PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  lines          PurchaseOrderLine[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([requisitionId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  productId       String        @db.Uuid
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

enum TypingTestMode {
  TIME
  WORDS
}

model TypingTestResult {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @db.Uuid
  wpm                 Float
  rawWpm              Float
  accuracy            Float
  correctCharacters   Int
  incorrectCharacters Int
  totalCharacters     Int
  wordsCompleted      Int
  durationSeconds     Int
  mode                TypingTestMode
  modeValue           Int
  textCategory        String
  createdAt           DateTime       @default(now())
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([mode, modeValue, wpm])
  @@index([wpm, accuracy, createdAt])
  @@map("typing_test_results")
}

model NumberMemoryResult {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  maxDigits Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, maxDigits])
  @@index([maxDigits, createdAt])
  @@map("number_memory_results")
}
