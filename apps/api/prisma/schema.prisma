generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  TERMINATED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ROLE_ASSIGNED
  ROLE_REMOVED
  PERMISSION_CHANGED
}

model User {
  id                     String                @id @default(uuid()) @db.Uuid
  email                  String                @unique
  passwordHash           String
  isActive               Boolean               @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  employee               Employee?
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  requestedRequisitions  PurchaseRequisition[] @relation("RequisitionRequester")
  approvedRequisitions   PurchaseRequisition[] @relation("RequisitionApprover")
  typingTestResults      TypingTestResult[]
  numberMemoryResults    NumberMemoryResult[]
  managedProjects        Project[]             @relation("ProjectManager")
  createdProjects        Project[]             @relation("ProjectCreator")
  projectMemberships     ProjectMember[]
  reportedWorkItems      WorkItem[]            @relation("WorkItemReporter")
  assignedWorkItems      WorkItem[]            @relation("WorkItemAssignee")
  workItemComments       WorkItemComment[]
  projectActivityLogs    ProjectActivityLog[]
  crmAssignedCases       CrmCase[]             @relation("CrmCaseAssignee")
  crmInteractions        CrmInteraction[]      @relation("CrmInteractionAgent")
  crmFollowUps           CrmFollowUp[]         @relation("CrmFollowUpAssignee")
  crmLogComments         CrmLogComment[]

  @@index([isActive])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  resource    String
  action      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  assignedAt   DateTime @default(now())
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Department {
  id            String                @id @default(uuid()) @db.Uuid
  name          String                @unique
  code          String                @unique
  description   String?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  employees     Employee[]
  positions     Position[]
  requisitions  PurchaseRequisition[]
  projects      Project[]

  @@index([isActive])
  @@map("departments")
}

model Position {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  code         String      @unique
  description  String?
  departmentId String?     @db.Uuid
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees    Employee[]

  @@index([departmentId])
  @@map("positions")
}

model Employee {
  id               String           @id @default(uuid()) @db.Uuid
  employeeNumber   String           @unique
  firstName        String
  middleName       String?
  lastName         String
  email            String           @unique
  phone            String?
  dateOfBirth      DateTime?        @db.Date
  hireDate         DateTime         @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE)
  userId           String?          @unique @db.Uuid
  departmentId     String?          @db.Uuid
  positionId       String?          @db.Uuid
  managerId        String?          @db.Uuid
  photoUrl         String?
  photoStorageKey  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  position         Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  manager          Employee?        @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports    Employee[]       @relation("EmployeeManager")

  @@index([departmentId])
  @@index([positionId])
  @@index([managerId])
  @@index([employmentStatus])
  @@map("employees")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  action     AuditAction
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([resource, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model MediaFolder {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?       @db.Uuid
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  parent    MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  MediaFolder[] @relation("MediaFolderTree")
  files     MediaFile[]

  @@index([parentId])
  @@map("media_folders")
}

model MediaFile {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  folderId   String?      @db.Uuid
  storageKey String
  url        String
  mimeType   String
  size       Int
  alt        String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  folder     MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([folderId])
  @@index([storageKey])
  @@map("media_files")
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

enum PurchaseRequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CONVERTED
}

model Product {
  id             String                     @id @default(uuid()) @db.Uuid
  sku            String                     @unique
  name           String
  description    String?
  unit           String                     @default("pcs")
  trackInventory Boolean                    @default(true)
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  poLines        PurchaseOrderLine[]
  prLines        PurchaseRequisitionLine[]

  @@index([isActive])
  @@map("products")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("suppliers")
}

model Warehouse {
  id             String          @id @default(uuid()) @db.Uuid
  code           String          @unique
  name           String
  isDefault      Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockBalances  StockBalance[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
  @@map("warehouses")
}

model StockBalance {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@index([productId])
  @@map("stock_balances")
}

model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  type          StockMovementType
  warehouseId   String            @db.Uuid
  productId     String            @db.Uuid
  quantity      Int
  referenceType String?
  referenceId   String?
  notes         String?
  createdById   String?           @db.Uuid
  createdAt     DateTime          @default(now())
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  product       Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([warehouseId, productId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

model PurchaseRequisition {
  id            String                     @id @default(uuid()) @db.Uuid
  number        String                     @unique
  status        PurchaseRequisitionStatus  @default(DRAFT)
  requestedById String                     @db.Uuid
  departmentId  String?                    @db.Uuid
  notes         String?
  approvedById  String?                    @db.Uuid
  approvedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  requestedBy   User                       @relation("RequisitionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy    User?                      @relation("RequisitionApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  department    Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lines         PurchaseRequisitionLine[]
  purchaseOrders PurchaseOrder[]

  @@index([status])
  @@index([requestedById])
  @@index([departmentId])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionLine {
  id             String              @id @default(uuid()) @db.Uuid
  requisitionId  String              @db.Uuid
  productId      String              @db.Uuid
  quantity       Int
  notes          String?
  requisition    PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  product        Product             @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([requisitionId])
  @@index([productId])
  @@map("purchase_requisition_lines")
}

model PurchaseOrder {
  id             String               @id @default(uuid()) @db.Uuid
  number         String               @unique
  supplierId     String               @db.Uuid
  warehouseId    String               @db.Uuid
  requisitionId  String?              @db.Uuid
  status         PurchaseOrderStatus  @default(DRAFT)
  orderDate      DateTime             @db.Date
  notes          String?
  createdById    String?              @db.Uuid
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  supplier       Supplier             @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  requisition    PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  lines          PurchaseOrderLine[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([requisitionId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @db.Uuid
  productId       String        @db.Uuid
  quantity        Int
  unitPrice       Decimal       @db.Decimal(12, 2)
  receivedQty     Int           @default(0)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_lines")
}

enum TypingTestMode {
  TIME
  WORDS
}

model TypingTestResult {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @db.Uuid
  wpm                 Float
  rawWpm              Float
  accuracy            Float
  correctCharacters   Int
  incorrectCharacters Int
  totalCharacters     Int
  wordsCompleted      Int
  durationSeconds     Int
  mode                TypingTestMode
  modeValue           Int
  textCategory        String
  createdAt           DateTime       @default(now())
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([mode, modeValue, wpm])
  @@index([wpm, accuracy, createdAt])
  @@map("typing_test_results")
}

model NumberMemoryResult {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  maxDigits Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, maxDigits])
  @@index([maxDigits, createdAt])
  @@map("number_memory_results")
}

enum ProjectMemberRole {
  PROJECT_MANAGER
  MEMBER
  OBSERVER
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model ProjectStatus {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  sortOrder   Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]

  @@index([isActive])
  @@map("project_statuses")
}

model WorkItemType {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workItems   WorkItem[]

  @@index([isActive])
  @@map("work_item_types")
}

model WorkItemStatus {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isDefault   Boolean    @default(false)
  isCompleted Boolean    @default(false)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workItems   WorkItem[]

  @@index([isActive])
  @@map("work_item_statuses")
}

model Project {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String
  key                String               @unique
  description        String?
  departmentId       String?              @db.Uuid
  projectManagerId   String               @db.Uuid
  statusId           String               @db.Uuid
  startDate          DateTime?            @db.Date
  endDate            DateTime?            @db.Date
  createdById        String               @db.Uuid
  nextWorkItemNumber Int                  @default(1)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  department         Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  projectManager     User                 @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: Restrict)
  createdBy          User                 @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  status             ProjectStatus        @relation(fields: [statusId], references: [id], onDelete: Restrict)
  members            ProjectMember[]
  workItems          WorkItem[]
  activityLogs       ProjectActivityLog[]

  @@index([departmentId])
  @@index([projectManagerId])
  @@index([statusId])
  @@index([createdById])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid()) @db.Uuid
  projectId String            @db.Uuid
  userId    String            @db.Uuid
  role      ProjectMemberRole @default(MEMBER)
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model WorkItem {
  id           String               @id @default(uuid()) @db.Uuid
  projectId    String               @db.Uuid
  number       Int
  typeId       String               @db.Uuid
  title        String
  description  String?
  statusId     String               @db.Uuid
  priority     WorkItemPriority     @default(MEDIUM)
  reporterId   String               @db.Uuid
  assigneeId   String?              @db.Uuid
  dueDate      DateTime?            @db.Date
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type         WorkItemType         @relation(fields: [typeId], references: [id], onDelete: Restrict)
  status       WorkItemStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  reporter     User                 @relation("WorkItemReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee     User?                @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments     WorkItemComment[]
  activityLogs ProjectActivityLog[]

  @@unique([projectId, number])
  @@index([projectId])
  @@index([typeId])
  @@index([statusId])
  @@index([reporterId])
  @@index([assigneeId])
  @@map("work_items")
}

model WorkItemComment {
  id         String   @id @default(uuid()) @db.Uuid
  workItemId String   @db.Uuid
  userId     String   @db.Uuid
  comment    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([workItemId])
  @@index([userId])
  @@map("work_item_comments")
}

model ProjectActivityLog {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  workItemId String?   @db.Uuid
  userId     String?   @db.Uuid
  action     String
  oldValue   String?
  newValue   String?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workItem   WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([workItemId])
  @@index([userId])
  @@map("project_activity_logs")
}

enum CrmChannel {
  PHONE
  EMAIL
  CHAT
  WALK_IN
  OTHER
}

enum CrmInteractionType {
  INBOUND_CALL
  OUTBOUND_CALL
  EMAIL
  CHAT
  OTHER
}

enum CrmResolution {
  RESOLVED_FIRST_CONTACT
  RESOLVED
  CALLBACK_REQUIRED
  PENDING
  ESCALATED
  NO_RESOLUTION
  OTHER
}

enum CrmInteractionStatus {
  COMPLETED
  PENDING
  IN_PROGRESS
  CANCELLED
}

enum CrmPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CrmCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum CrmFollowUpStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CrmFollowUpType {
  CALL
  EMAIL
  VISIT
  OTHER
}

enum CrmStore {
  PHARMACY_DIRECT
  CHEMPRO
  CHEMIST_OUTLET
  CHEMIST_AUSTRALIA
  OTHER
}

model Customer {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique
  name           String
  storeName      String?
  phone          String?
  email          String?
  address        String?
  notes          String?
  isActive       Boolean  @default(true)
  legacySource   String?
  legacyRecordId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  interactions   CrmInteraction[]
  cases          CrmCase[]
  followUps      CrmFollowUp[]

  @@index([name])
  @@index([storeName])
  @@index([phone])
  @@index([email])
  @@index([isActive])
  @@unique([legacySource, legacyRecordId])
  @@map("customers")
}

model CrmCase {
  id             String        @id @default(uuid()) @db.Uuid
  caseNumber     String        @unique
  customerId     String        @db.Uuid
  subject        String
  description    String?
  priority       CrmPriority   @default(NORMAL)
  status         CrmCaseStatus @default(OPEN)
  assignedToId   String?       @db.Uuid
  closedAt       DateTime?
  legacySource   String?
  legacyRecordId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo     User?         @relation("CrmCaseAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  interactions   CrmInteraction[]
  followUps      CrmFollowUp[]

  @@index([customerId])
  @@index([assignedToId])
  @@index([status])
  @@index([priority])
  @@unique([legacySource, legacyRecordId])
  @@map("crm_cases")
}

model CrmInteraction {
  id               String                 @id @default(uuid()) @db.Uuid
  interactionNumber String                @unique
  customerId       String                 @db.Uuid
  caseId           String?                @db.Uuid
  agentId          String                 @db.Uuid
  store            CrmStore               @default(OTHER)
  storeOther       String?
  orderNumber      String?
  channel          CrmChannel
  interactionType  CrmInteractionType
  interactionDate  DateTime
  durationSeconds  Int?
  inquiry          String?
  notes            String?
  resolution       CrmResolution?
  status           CrmInteractionStatus   @default(COMPLETED)
  priority         CrmPriority            @default(NORMAL)
  legacySource     String?
  legacyRecordId   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  case             CrmCase?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  agent            User                   @relation("CrmInteractionAgent", fields: [agentId], references: [id], onDelete: Restrict)
  followUps        CrmFollowUp[]
  comments         CrmLogComment[]

  @@index([customerId])
  @@index([caseId])
  @@index([agentId])
  @@index([interactionDate])
  @@index([status])
  @@index([priority])
  @@index([channel])
  @@index([store])
  @@index([orderNumber])
  @@unique([legacySource, legacyRecordId])
  @@map("crm_interactions")
}

model CrmFollowUp {
  id             String             @id @default(uuid()) @db.Uuid
  interactionId  String?            @db.Uuid
  caseId         String?            @db.Uuid
  customerId     String             @db.Uuid
  assignedToId   String             @db.Uuid
  followUpDate   DateTime
  followUpType   CrmFollowUpType    @default(CALL)
  notes          String?
  status         CrmFollowUpStatus  @default(PENDING)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  interaction    CrmInteraction?    @relation(fields: [interactionId], references: [id], onDelete: SetNull)
  case           CrmCase?           @relation(fields: [caseId], references: [id], onDelete: SetNull)
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedTo     User               @relation("CrmFollowUpAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([interactionId])
  @@index([caseId])
  @@index([assignedToId])
  @@index([followUpDate])
  @@index([status])
  @@map("crm_follow_ups")
}

model CrmLogComment {
  id             String         @id @default(uuid()) @db.Uuid
  interactionId  String         @db.Uuid
  userId         String         @db.Uuid
  comment        String
  createdAt      DateTime       @default(now())
  interaction    CrmInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([interactionId])
  @@index([userId])
  @@map("crm_log_comments")
}
