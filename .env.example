# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/worknest?schema=public

# API
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Seed admin (used by Prisma seed)
ADMIN_EMAIL=admin@worknest.local
ADMIN_PASSWORD=ChangeMeAdmin123!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Media / file uploads (API)
UPLOAD_DIR=uploads
MEDIA_PUBLIC_BASE_URL=http://localhost:4000
